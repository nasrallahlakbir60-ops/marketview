# Copier ce fichier en .env (jamais commité) puis compléter.
# Toutes les clés API sont facultatives : sans clé, la source est ignorée et le panneau affiche « Source non configurée ».

# --- Base de données et cache ---
POSTGRES_DB=marketview
POSTGRES_USER=marketview
POSTGRES_PASSWORD=marketview_local
DATABASE_URL=postgresql+psycopg://marketview:marketview_local@db:5432/marketview
REDIS_URL=redis://redis:6379/0

# --- API ---
# Origines autorisées (séparées par des virgules). En production derrière Nginx (même domaine), peut rester vide.
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
# Requêtes par minute et par IP sur les routes publiques (0 = désactivé).
RATE_LIMIT_PER_MINUTE=120
# true : le scheduler tourne dans le processus API (dev). La prod utilise un service "worker" dédié.
RUN_SCHEDULER=true
NEWS_FETCH_INTERVAL_SECONDS=60
# Secret de /api/cron/refresh (hébergement Vercel). Générer une longue valeur aléatoire.
CRON_SECRET=

# --- Comptes utilisateurs ---
# Connexion Google : console.cloud.google.com > API et services > Identifiants > ID client OAuth (application Web).
# Origines JavaScript autorisées : http://localhost:5173 et https://votre-domaine. Vide = connexion Google masquée.
GOOGLE_CLIENT_ID=
# Durée d'une session de connexion, en jours.
SESSION_DAYS=30
# Cookie de session réservé à HTTPS (true en production). Vide = automatique (activé sur Vercel).
COOKIE_SECURE=
# Tentatives d'inscription / connexion par minute et par IP.
AUTH_RATE_LIMIT_PER_MINUTE=10
# Conservation du journal d'activité (connexions, inscriptions...) en base, en jours.
AUDIT_RETENTION_DAYS=365

# --- Logs ---
# text (lisible) ou json (une ligne JSON par log, pour un outil de collecte). Vide = json sur Vercel, text ailleurs.
LOG_FORMAT=
# Fichier de logs avec rotation automatique (10 Mo x 5 fichiers), ex : /app/logs/marketview.log. Vide = console seulement.
LOG_FILE=

# --- Clés API (voir docs/api_sources.md) ---
# Finnhub : news forex/crypto + calendrier économique (le calendrier peut nécessiter une offre payante).
FINNHUB_API_KEY=
# FRED : inflation US mensuelle (CPI, core CPI) et taux de la Fed.
FRED_API_KEY=
# Réservées pour la V2 (non utilisées par le MVP) :
NEWSAPI_KEY=
MARKETAUX_KEY=
TRADINGECONOMICS_KEY=
TWELVEDATA_KEY=
JWT_SECRET=

# --- Frontend (dev) ---
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# --- Production ---
HTTP_PORT=80
